<?xml version="1.0" encoding="utf-8"?>
<!--
  朝暮桌面小组件外壳（2026-11-04 改成可滑动）。
  列表内容由 ChaomuWidgetService 提供，能上下滑看全部今日待办。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <!-- 标题行：点它打开 App -->
    <LinearLayout
        android:id="@+id/widget_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp"
        android:paddingBottom="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朝暮"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#1A1D26" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text=""
            android:textSize="11sp"
            android:textColor="#949CAA" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="#185FA5" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#E2E6EE" />

    <!-- 可上下滑动的待办列表 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#00000000"
        android:dividerHeight="0dp"
        android:layout_marginTop="2dp" />

    <!-- 列表空的时候显示 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="今天没有待办"
        android:textSize="12sp"
        android:textColor="#B8BDC8"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
