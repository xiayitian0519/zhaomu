<?xml version="1.0" encoding="utf-8"?>
<!--
  朝暮桌面小组件外壳（2026-11-04 改成可滑动，2026-11-05 修裸 View）。
  列表内容由 ChaomuWidgetService 提供，能上下滑看全部今日待办。
  注意：分隔线不能用裸 <View>（RemoteViews 白名单不允许），用 TextView 当线。
  背景色由代码按「透明度」动态 setBackgroundColor 设，所以这里不写 background。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 标题行：点它打开 App -->
    <LinearLayout
        android:id="@+id/widget_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="朝暮"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1A1D26" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textSize="12sp"
            android:textColor="#949CAA" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#185FA5" />

        <!-- 「今天 / 全部」切换：点一下切换显示范围（2026-11-05） -->
        <TextView
            android:id="@+id/widget_scope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="今天"
            android:textSize="12sp"
            android:textColor="#185FA5"
            android:background="@drawable/widget_scope_bg" />

        <!-- 「设置」：打开小组件自己的设置页（背景透明度 / 显示范围）。
             2026-11-05 用户要求把透明度从 App 设置里挪到组件设置里，这是直达入口。 -->
        <TextView
            android:id="@+id/widget_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="设置"
            android:textSize="12sp"
            android:textColor="#185FA5"
            android:background="@drawable/widget_scope_bg" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#668A91A0" />

    <!-- 可上下滑动的待办列表 -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#00000000"
        android:dividerHeight="0dp"
        android:layout_marginTop="4dp" />

    <!-- 列表空的时候显示 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="今天没有待办"
        android:textSize="13sp"
        android:textColor="#B8BDC8"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>
